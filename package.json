{
  "name": "inglorious-forge",
  "private": true,
  "description": "A collection of small, focused JavaScript tools \u2014 forged one piece at a time.",
  "author": "IceOnFire <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "lint": "turbo lint && node scripts/verify-docs.mjs",
    "test": "turbo test",
    "build": "turbo build",
    "dev": "turbo dev",
    "prepare": "husky",
    "ci:version": "pnpm run build && pnpm run lint && pnpm run test && changeset version",
    "ci:publish": "changeset publish",
    "turbo:upgrade": "pnpm dlx @turbo/codemod migrate",
    "verify:docs": "node scripts/verify-docs.mjs",
    "skills:index": "node scripts/skills-index.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@inglorious/eslint-config": "workspace:*",
    "@rollup/rollup-darwin-arm64": "4.68.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,ijs,its}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">= 26"
  }
}
