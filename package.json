{
  "name": "inglorious-forge",
  "private": true,
  "description": "A collection of small, focused JavaScript tools — forged one piece at a time.",
  "author": "IceOnFire <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "lint": "turbo lint",
    "test": "turbo test",
    "build": "turbo build",
    "dev": "turbo dev",
    "prepare": "husky",
    "ci:version": "pnpm run build && pnpm run lint && pnpm run test && changeset version",
    "ci:publish": "changeset publish",
    "turbo:upgrade": "pnpm dlx @turbo/codemod migrate"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@inglorious/eslint-config": "workspace:*",
    "@rollup/rollup-darwin-arm64": "4.63.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css,scss,html,yml,yaml}": "prettier --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">= 22"
  }
}
