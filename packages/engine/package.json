{
  "name": "@inglorious/engine",
  "version": "24.2.1",
  "description": "A JavaScript game engine written with global state, immutability, and pure functions in mind. Have fun(ctional programming) with it!",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/engine"
  },
  "homepage": "https://inglorious-engine.vercel.app/",
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "data-oriented",
    "ecs",
    "functional-programming",
    "gamedev",
    "game-engine"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts"
    },
    "./*.js": {
      "types": "./types/*.d.ts",
      "import": "./src/*.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src",
    "types",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:types": "tsc -p type-tests"
  },
  "dependencies": {
    "@inglorious/store": "workspace:^",
    "@inglorious/utils": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "^5.1.1"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">= 26"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
