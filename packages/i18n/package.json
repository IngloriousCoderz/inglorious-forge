{
  "name": "@inglorious/i18n",
  "version": "1.3.0",
  "description": "Internationalization for Inglorious Web: an i18next instance driven by a store entity.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "i18n",
    "i18next",
    "internationalization",
    "localization",
    "inglorious-web"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^26.5.2"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "@inglorious/store": "workspace:*",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 26"
  }
}
