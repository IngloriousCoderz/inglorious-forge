{
  "name": "@inglorious/utils",
  "version": "4.0.0",
  "description": "A set of general-purpose utility functions designed with functional programming principles in mind.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/utils"
  },
  "homepage": "https://inglorious-engine.vercel.app/",
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "functional-programming",
    "gamedev",
    "game-engine",
    "inglorious-engine",
    "utils"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./algorithms": {
      "types": "./types/algorithms/index.d.ts",
      "import": "./src/algorithms/index.js"
    },
    "./algorithms/*.js": {
      "types": "./types/algorithms/*.d.ts",
      "import": "./src/algorithms/*.js"
    },
    "./algorithms/*": {
      "types": "./types/algorithms/*.d.ts",
      "import": "./src/algorithms/*.js"
    },
    "./data-structures": {
      "types": "./types/data-structures/index.d.ts",
      "import": "./src/data-structures/index.js"
    },
    "./data-structures/*.js": {
      "types": "./types/data-structures/*.d.ts",
      "import": "./src/data-structures/*.js"
    },
    "./data-structures/*": {
      "types": "./types/data-structures/*.d.ts",
      "import": "./src/data-structures/*.js"
    },
    "./functions": {
      "types": "./types/functions/index.d.ts",
      "import": "./src/functions/index.js"
    },
    "./math": {
      "types": "./types/math/index.d.ts",
      "import": "./src/math/index.js"
    },
    "./math/*.js": {
      "types": "./types/math/*.d.ts",
      "import": "./src/math/*.js"
    },
    "./math/*": {
      "types": "./types/math/*.d.ts",
      "import": "./src/math/*.js"
    },
    "./physics": {
      "types": "./types/physics/index.d.ts",
      "import": "./src/physics/index.js"
    },
    "./physics/*.js": {
      "types": "./types/physics/*.d.ts",
      "import": "./src/physics/*.js"
    },
    "./physics/*": {
      "types": "./types/physics/*.d.ts",
      "import": "./src/physics/*.js"
    },
    "./object.js": {
      "types": "./types/data-structures/object.d.ts",
      "import": "./src/data-structures/object.js"
    },
    "./object": {
      "types": "./types/data-structures/object.d.ts",
      "import": "./src/data-structures/object.js"
    },
    "./quaternions.js": {
      "types": "./types/math/quaternions.d.ts",
      "import": "./src/math/quaternions.js"
    },
    "./quaternions": {
      "types": "./types/math/quaternions.d.ts",
      "import": "./src/math/quaternions.js"
    },
    "./vectors.js": {
      "types": "./types/math/vectors.d.ts",
      "import": "./src/math/vectors.js"
    },
    "./vectors": {
      "types": "./types/math/vectors.d.ts",
      "import": "./src/math/vectors.js"
    },
    "./v.js": {
      "types": "./types/v.d.ts",
      "import": "./src/v.js"
    },
    "./v": {
      "types": "./types/v.d.ts",
      "import": "./src/v.js"
    }
  },
  "files": [
    "src",
    "types",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  }
}
