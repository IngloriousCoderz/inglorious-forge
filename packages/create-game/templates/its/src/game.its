/// <reference path="../types/globals.d.ts" />
import type { GameConfig } from "@inglorious/engine"
import {
  controlTypes,
  createControlEntities,
} from "@inglorious/engine/behaviors/input/controls.js"

import { HEIGHT, MARGIN, ROUND_SECONDS, WIDTH } from "./constants"
import Coin, { createCoin } from "./types/coin.its"
import Game from "./types/game.its"
import Player from "./types/player.its"
import Score from "./types/score.its"

export default {
  types: {
    ...controlTypes(),
    Game,
    Player,
    Coin,
    Score,
  },

  entities: {
    ...createControlEntities(
      {
        ArrowUp: "moveUp",
        ArrowDown: "moveDown",
        ArrowLeft: "moveLeft",
        ArrowRight: "moveRight",
        KeyW: "moveUp",
        KeyS: "moveDown",
        KeyA: "moveLeft",
        KeyD: "moveRight",
        Axis0: "moveLeftRight",
        Axis1: "moveUpDown",
        Space: "restart",
        Btn0: "restart",
      },
      ["restart"],
    ),

    game: {
      type: "Game",
      devMode: true,
      size: v(WIDTH, HEIGHT),
      backgroundColor: "#1d1f33",
      state: "play",
      timeLeft: ROUND_SECONDS,
    },

    player: {
      type: "Player",
      position: v(WIDTH / 2, 0, HEIGHT / 2),
      size: v(32, 0, 32),
      radius: 16,
      maxSpeed: 300,
      color: "white",
      backgroundColor: "#4fc3f7",
      collisions: { hitbox: { shape: "circle" } },
    },

    coin1: createCoin("coin1"),
    coin2: createCoin("coin2"),
    coin3: createCoin("coin3"),

    score: {
      type: "Score",
      position: v(MARGIN / 2, 0, HEIGHT - MARGIN / 2),
      font: "monospace",
      size: 20,
      lineHeight: 28,
      color: "white",
      points: 0,
      level: 1,
      best: 0,
    },
  },
} satisfies GameConfig
