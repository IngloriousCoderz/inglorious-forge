{
  "name": "@inglorious/supabase",
  "version": "0.10.0",
  "description": "Supabase integration for Inglorious Web, and helpers for Supabase Edge Functions.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/supabase"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "supabase",
    "realtime",
    "inglorious-web",
    "edge-functions",
    "deno"
  ],
  "type": "module",
  "bin": {
    "inglorious-live-update": "./bin/live-update.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./edge": {
      "types": "./types/edge.d.ts",
      "import": "./src/edge/index.js"
    },
    "./live-update": {
      "types": "./types/live-update.d.ts",
      "import": "./src/live-update/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">= 26"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
