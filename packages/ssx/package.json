{
  "name": "@inglorious/ssx",
  "version": "2.1.5",
  "description": "Server-Side-X. Xecution? Xperience? Who knows.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/store"
  },
  "homepage": "https://inglorious-engine.vercel.app/",
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "ssg",
    "ssr",
    "server",
    "inglorious",
    "web",
    "framework"
  ],
  "type": "module",
  "bin": {
    "ssx": "./bin/ssx.js"
  },
  "exports": {
    ".": "./types/index.d.ts",
    "./dev": "./src/dev/index.js",
    "./build": "./src/build/index.js",
    "./serve": "./src/serve/index.js",
    "./markdown": "./src/utils/markdown.js",
    "./i18n": {
      "types": "./types/i18n.d.ts",
      "import": "./src/utils/i18n.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run",
    "dev": "node ./bin/ssx.js dev -r ./src/__fixtures__",
    "build": "node ./bin/ssx.js build -r ./src/__fixtures__",
    "preview": "node ./bin/ssx.js serve -r ./src/__fixtures__",
    "ssr": "node ./bin/ssx.js ssr -r ./src/__fixtures__"
  },
  "dependencies": {
    "@inglorious/store": "workspace:*",
    "@inglorious/utils": "workspace:*",
    "@inglorious/web": "workspace:*",
    "@lit-labs/ssr": "^4.1.0",
    "commander": "^15.0.0",
    "connect": "^3.7.0",
    "fast-xml-parser": "^5.11.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.6",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "vite": "^8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "@inglorious/logo": "workspace:*",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  }
}
