{
  "name": "@inglorious/capacitor",
  "version": "0.4.0",
  "description": "Configures Capacitor's native projects from package.json, makes their icons and splash screens from one logo, and the screenshots and graphics the stores ask for.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/capacitor"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "capacitor",
    "ios",
    "android",
    "app-links",
    "icons",
    "splash-screen",
    "inglorious-web",
    "store-listing"
  ],
  "type": "module",
  "bin": {
    "inglorious-capacitor": "./bin/inglorious-capacitor.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/assets": "^4.0.0",
    "@trapezedev/project": "^7.1.11",
    "playwright-core": "^1.65.0",
    "plist": "^3.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">= 26"
  }
}
