{
  "name": "@inglorious/renderer-2d",
  "version": "22.1.1",
  "description": "A renderer for the Inglorious Engine, using the Context2D of the Canvas API.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/renderer-2d"
  },
  "homepage": "https://inglorious-engine.vercel.app/",
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./*.js": {
      "types": "./types/*.d.ts",
      "import": "./src/*.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:types": "tsc -p type-tests"
  },
  "peerDependencies": {
    "@inglorious/engine": "workspace:^",
    "@inglorious/utils": "workspace:^"
  },
  "devDependencies": {
    "@inglorious/engine": "workspace:*",
    "@inglorious/eslint-config": "workspace:*",
    "@inglorious/utils": "workspace:*",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
