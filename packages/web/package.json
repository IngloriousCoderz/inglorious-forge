  "files": [
    "src",
    "types",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run && tsc -p type-tests",
    "test:types": "tsc -p type-tests"
  },
  "dependencies": {
    "@inglorious/utils": "workspace:^",
    "@lit-labs/ssr-client": "^1.1.8",
    "lit-html": "^3.3.3"
  },
  "peerDependencies": {
    "@inglorious/store": "workspace:^"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">= 26"
  }
}
