      "import": "./src/auth/index.js"
    },
    "./native/back-button": {
      "types": "./types/native/back-button.d.ts",
      "import": "./src/native/back-button/index.js"
    },
    "./native/system-bars": {
      "types": "./types/native/system-bars.d.ts",
      "import": "./src/native/system-bars/index.js"
    },
    "./decorators/with-debounce": {
      "types": "./types/decorators/with-debounce.d.ts",
      "import": "./src/decorators/with-debounce/index.js"
    },
    "./decorators/with-error-boundary": {
      "types": "./types/decorators/with-error-boundary.d.ts",
      "import": "./src/decorators/with-error-boundary/index.js"
