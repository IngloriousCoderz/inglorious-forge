{
  "name": "@inglorious/openui",
  "version": "0.5.3",
  "description": "Generative UI for Inglorious Web: render OpenUI Lang from a model, streamed into a store entity, with Inglorious UI components.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/openui"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "openui",
    "generative-ui",
    "llm",
    "streaming",
    "inglorious-web"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./charts": {
      "types": "./types/charts.d.ts",
      "import": "./src/library/charts/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "!src/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:watch": "vitest",
    "test": "vitest run && tsc -p type-tests",
    "test:types": "tsc -p type-tests"
  },
  "dependencies": {
    "@openuidev/lang-core": "^1.0.1",
    "markdown-it": "^14.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@inglorious/charts": "workspace:*",
    "@inglorious/ui": "workspace:*",
    "@inglorious/web": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@inglorious/charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inglorious/charts": "workspace:*",
    "@inglorious/eslint-config": "workspace:*",
    "@inglorious/store": "workspace:*",
    "@inglorious/ui": "workspace:*",
    "@inglorious/web": "workspace:*",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  }
}
