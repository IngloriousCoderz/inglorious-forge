{
  "name": "@inglorious/charts",
  "version": "12.2.3",
  "description": "Chart components for Inglorious Web, inspired by Recharts",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "contributors": [
    {
      "name": "Vinícius Mantovani",
      "email": "vmantovani86@gmail.com",
      "url": "https://viniciusmantovani.netlify.app/"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "charts",
    "svg",
    "d3",
    "inglorious"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./realtime": {
      "types": "./types/realtime.d.ts",
      "import": "./src/decorators/with-realtime.js"
    },
    "./base.css": "./src/base.css",
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "src",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write '**/*.{js,jsx}'",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test:watch": "vitest",
    "test": "vitest run && tsc -p type-tests",
    "test:types": "tsc -p type-tests"
  },
  "dependencies": {
    "@inglorious/web": "workspace:*",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0"
  },
  "peerDependencies": {
    "@inglorious/web": "workspace:*"
  },
  "devDependencies": {
    "@inglorious/eslint-config": "workspace:*",
    "@inglorious/store": "workspace:*",
    "@lit-labs/ssr": "^4.1.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">= 22"
  }
}
