{
  "name": "@inglorious/vite-plugin-vue",
  "version": "1.0.2",
  "description": "A Vite plugin that transforms Vue-like template syntax into lit-html templates.",
  "author": "Matteo Antony Mistretta <antony.mistretta@gmail.com> (https://ingloriouscoderz.it)",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "homepage": "https://github.com/IngloriousCoderz/inglorious-forge/tree/main/packages/vite-plugin-vue#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/IngloriousCoderz/inglorious-forge.git",
    "directory": "packages/vite-plugin-vue"
  },
  "bugs": {
    "url": "https://github.com/IngloriousCoderz/inglorious-forge/issues"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "inglorious",
    "vue",
    "lit-html"
